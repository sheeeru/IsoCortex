# =============================================================================
# IsoCortex — .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
ENV/

# --- Testing / Coverage ---
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node.js ---
node_modules/
.next/
out/
.turbo/
.vercel/

# --- LaTeX build artifacts ---
docs/*.aux
docs/*.log
docs/*.toc
docs/*.lof
docs/*.lot
docs/*.synctex.gz
docs/*.pdf
docs/*.out
docs/*.fls
docs/*.fdb_latexmk

# --- C++ build artifacts ---
*.o
*.obj
*.a
*.lib
*.dylib
*.dll
*.exe
cmake-build-*/
CMakeFiles/
CMakeCache.txt
*.dSYM/

# --- PyInstaller ---
*.spec

# --- ML model binaries (use Git LFS if you need to track these) ---
*.onnx
*.pt
*.pth
*.h5
*.safetensors
*.gguf

# --- IsoCortex data (never commit user data) ---
.isocortex/
*.bin
vectors.bin

# --- Database files ---
*.db
*.sqlite
*.sqlite3

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace

# --- OS ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Docker ---
docker-compose.override.yml

# --- Dev-only (not for production) ---
worklog.md

# --- Distribution archives ---
*.zip
*.tar.gz
*.rar
*.7z

# --- Misc ---
*.log
*.tmp
*.bak
npm-debug.log*