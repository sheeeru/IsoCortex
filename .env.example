# =============================================================================
# IsoCortex — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Server ---
ISOCORTEX_HOST=0.0.0.0
ISOCORTEX_PORT=8900
ISOCORTEX_WORKERS=1
ISOCORTEX_LOG_LEVEL=INFO

# --- Security ---
# IMPORTANT: Change this in production! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ISOCORTEX_SECRET_KEY=change-me-in-production

# --- Storage ---
# ISOCORTEX_DATA_DIR=~/.isocortex

# --- Performance ---
ISOCORTEX_MAX_MEMORY_MB=4096
ISOCORTEX_EF_SEARCH=40

# --- Rate Limiting ---
ISOCORTEX_RATE_LIMIT_RPM=60
ISOCORTEX_RATE_LIMIT_BURST=10

# --- Embedding Model (optional, uses defaults if unset) ---
# ISOCORTEX_EMBEDDING_MODEL=all-MiniLM-L6-v2
# ISOCORTEX_EMBEDDING_DEVICE=cpu

# --- Web UI ---
# NEXT_PUBLIC_API_URL=http://localhost:8900
